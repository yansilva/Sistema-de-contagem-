# Variaveis lidas pelo docker-compose.yml (arquivo .env na raiz, fora do Git).
# Copie para .env e preencha. Nao versione valores reais.

# Senha do usuario postgres do container (obrigatoria)
POSTGRES_PASSWORD=

# Segredo JWT, minimo 32 caracteres (obrigatorio). Ex.: openssl rand -base64 64
JWT_SECRET=
