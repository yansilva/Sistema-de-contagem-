# ==============================================================================
# INVENTORY MANAGEMENT SYSTEM (SAAS) — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Renomeie este arquivo para .env no ambiente de desenvolvimento ou configure
# estas variáveis no seu provedor de nuvem / container (Docker, Render, AWS, Railway).

# Servidor HTTP
PORT=3002
NODE_ENV=development

# Banco de Dados PostgreSQL
# Opção 1: String de conexão única
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/estoque_db

# Opção 2: Credenciais individuais (usadas se DATABASE_URL não for definida)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=estoque_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Autenticação JWT (Use strings criptograficamente seguras com 64+ caracteres em produção)
# Exemplo para gerar no terminal: openssl rand -base64 64
JWT_SECRET=super_secret_jwt_key_inventory_2026_dev_only_change_in_production_32char
JWT_EXPIRA_EM=15m
REFRESH_TOKEN_EXPIRA_DIAS=30

# Segurança e CORS
# Permita apenas as origens legítimas separadas por vírgula em produção
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:5500

# Sandbox Demo (Loja Modelo para testes públicos de portfólio)
DEMO_ACCOUNT_EMAIL=contato@lojademo.com
