# ==============================================================================
# INVENTORY MANAGEMENT SYSTEM (SAAS) — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Renomeie este arquivo para .env no ambiente de desenvolvimento ou configure
# estas variáveis no seu provedor de nuvem / container (Docker, Render, AWS, Railway).

# Servidor HTTP
PORT=3002
NODE_ENV=development

# Banco de Dados PostgreSQL
# Opção 1: String de conexão única
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/estoque_db

# Opção 2: Credenciais individuais (usadas se DATABASE_URL não for definida)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=estoque_db
DB_USER=postgres
DB_PASSWORD=postgres
# SSL e ativado automaticamente para DATABASE_URL remota; use true para forcar.
# DB_SSL_REJECT_UNAUTHORIZED=true valida o certificado do servidor (recomendado com CA confiavel).
DATABASE_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# Banco exclusivo dos testes de integracao (opcional; sem ele esses testes sao ignorados)
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/estoque_test

# Autenticação JWT (obrigatório em produção: 32+ caracteres)
# openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRA_EM=15m
REFRESH_TOKEN_EXPIRA_DIAS=30

# Segurança e CORS
# Permita apenas as origens legítimas separadas por vírgula em produção
FRONTEND_URL=http://localhost:3002
# CORS: lista EXATA de origens permitidas, separadas por virgula (ex.: https://app.exemplo.com).
# Sem curinga e sem sufixo *.vercel.app. Localhost so e aceito fora de producao.
# Deixe vazio se o frontend e servido pela propria API (mesma origem).
CORS_ALLOWED_ORIGINS=
# Atras de proxy reverso (nao Vercel), defina true para usar X-Forwarded-For no IP de auditoria.
TRUST_PROXY=false
# O Swagger (/api/docs) so e exposto quando NODE_ENV != production.

# Provisionamento Seguro do Super Admin (Admin Master da Plataforma)
# Usado pelo comando: npm run seed:superadmin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_SENHA=
SUPER_ADMIN_NOME=Super Administrador

# Cadastro de empresas pelo superadmin autenticado
ALLOW_PUBLIC_REGISTRATION=false
